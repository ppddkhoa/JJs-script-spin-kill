-- === HÀM TẠO THANH TRƯỢT ===
local function MakeSlider(Label, Min, Max, Default, Key, Y)
    local Lbl = Instance.new("TextLabel")
    Lbl.Size = UDim2.new(1, 0, 0, 20)
    Lbl.Position = UDim2.new(0, 0, Y, 0)
    Lbl.BackgroundTransparency = 1
    Lbl.Text = Label .. ": " .. Default
    Lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
    Lbl.Font = Enum.Font.Gotham
    Lbl.TextSize = 12
    Lbl.TextXAlignment = Enum.TextXAlignment.Left
    Lbl.Parent = Container

    local Bar = Instance.new("TextButton")
    Bar.Size = UDim2.new(1, 0, 0, 18)
    Bar.Position = UDim2.new(0, 0, Y + 0.06, 0)
    Bar.BackgroundColor3 = Color3.fromRGB(50, 50, 90)
    Bar.Text = ""
    Bar.Parent = Container

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new(0, 15, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(60, 180, 255)
    Fill.Parent = Bar

    local Dragging = false
    Bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if Dragging then
            local Ratio = math.clamp((i.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
            local Value = Min + (Max - Min) * Ratio
            Value = math.floor(Min) == Min and math.floor(Value) or tonumber(string.format("%.1f", Value))
            Settings[Key] = Value
            Fill.Position = UDim2.new(Ratio, -7, 0, 0)
            Lbl.Text = Label .. ": " .. Value
        end
    end)
    UIS.InputEnded:Connect(function() Dragging = false end)
end

