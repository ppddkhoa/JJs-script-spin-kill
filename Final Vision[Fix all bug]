-- === PHỤC HỒI CAMERA ===
local function RestoreCamera()
    if CamLocked then
        pcall(function()
            if Me.Character and Me.Character:FindFirstChild("Humanoid") then
                Cam.CameraSubject = Me.Character.Humanoid
            else
                Cam.CameraSubject = CamSavedSubject
            end
            Cam.CameraType = CamSavedType or Enum.CameraType.Custom
        end)
        CamSavedSubject = nil
        CamSavedType = nil
        CamLocked = false
    end
    if Me.Character and Me.Character:FindFirstChild("Humanoid") then
        Me.Character.Humanoid.GravityScale = 1
        Me.Character.Humanoid.PlatformStand = false
    end
    Target = nil
end

local function SaveCamera()
    if not CamLocked then
        CamSavedSubject = Cam.CameraSubject
        CamSavedType = Cam.CameraType
        CamLocked = true
    end
end

-- === HIGHLIGHT + NHÌN THẤY MÁU ===
local function CreateHighlight(Char)
    if not Char or Char:FindFirstChild("VISION5_Highlight") then return end
    local HL = Instance.new("Highlight")
    HL.Name = "VISION5_Highlight"
    HL.Adornee = Char
    HL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    HL.FillTransparency = 1
    HL.OutlineTransparency = 0
    HL.Parent = Char
    return HL
end

-- === HIỆU ỨNG MÀU ===
RunService.Heartbeat:Connect(function()
    local t = os.clock() * 0.8
    for _, Data in pairs(ESP_List) do
        if Data and Data.Highlight and Data.Highlight.Parent then
            local R = math.sin(t) * 0.5 + 0.5
            local G = math.sin(t + 2) * 0.5 + 0.5
            local B = math.sin(t + 4) * 0.5 + 0.5
            Data.Highlight.OutlineColor = Color3.new(R, G, B)
        end
    end
end)

-- === TẠO ESP CHO NGƯỜI ===
local function AddESP(Player)
    if Player == Me then return end
    if ESP_List[Player] then RemoveESP(Player) end

    local function Setup(Char)
        if not Char or not Char:FindFirstChild("Head") or not Char:FindFirstChild("Humanoid") then return end
        if ESP_List[Player] and ESP_List[Player].NameTag then ESP_List[Player].NameTag:Destroy() end

        local NameTag = Instance.new("BillboardGui")
        NameTag.Name = "NameTag"
        NameTag.Adornee = Char.Head
        NameTag.AlwaysOnTop = true
        NameTag.MaxDistance = 400
        NameTag.Size = UDim2.new(0, 180, 0, 35)
        NameTag.StudsOffset = Vector3.new(0, 7, 0)
        NameTag.Parent = Char.Head

        local NameLabel = Instance.new("TextLabel")
        NameLabel.Size = UDim2.new(1, 0, 1, 0)
        NameLabel.BackgroundTransparency = 1
        NameLabel.Text = string.upper(Player.Name)
        NameLabel.TextColor3 = Color3.new(1, 1, 1)
        NameLabel.Font = Enum.Font.GothamBold
        NameLabel.TextSize = 16
        NameLabel.TextStrokeTransparency = 0.2
        NameLabel.Parent = NameTag

        local HealthTag = Instance.new("BillboardGui")
        HealthTag.Name = "HealthTag"
        HealthTag.Adornee = Char.Head
        HealthTag.AlwaysOnTop = true
        HealthTag.MaxDistance = 400
        HealthTag.Size = UDim2.new(0, 160, 0, 28)
        HealthTag.StudsOffset = Vector3.new(0, 3, 0)
        HealthTag.Parent = Char.Head

        local HealthLabel = Instance.new("TextLabel")
        HealthLabel.Size = UDim2.new(1, 0, 1, 0)
        HealthLabel.BackgroundTransparency = 1
        HealthLabel.Text = "❤️ 100/100"
        HealthLabel.TextColor3 = Color3.new(1, 1, 1)
        HealthLabel.Font = Enum.Font.GothamBold
        HealthLabel.TextSize = 14
        HealthLabel.TextStrokeTransparency = 0.2
        HealthLabel.Parent = HealthTag

        local HL = CreateHighlight(Char)
        local Hum = Char:FindFirstChild("Humanoid")
        ESP_List[Player] = {
            NameTag = NameTag,
            HealthTag = HealthTag,
            HealthLabel = HealthLabel,
            Highlight = HL,
            Char = Char,
            Hum = Hum,
            LastHealth = -1
        }
    end

    if Player.Character then Setup(Player.Character) end
    -- ✅ Tự thêm khi mới vào / hồi sinh
    Player.CharacterAdded:Connect(function(Char)
        task.wait(0.25)
        Setup(Char)
    end)
end

-- === XÓA ESP ===
function RemoveESP(Player)
    if Target and Players:GetPlayerFromCharacter(Target) == Player then
        RestoreCamera()
    end
    local Data = ESP_List[Player]
    if Data then
        if Data.NameTag then Data.NameTag:Destroy() end
        if Data.HealthTag then Data.HealthTag:Destroy() end
        if Data.Highlight then Data.Highlight:Destroy() end
        ESP_List[Player] = nil
    end
end

-- === CẬP NHẬT MÁU ===
local UPDATE_INTERVAL = 0.15
local Acc = 0
RunService.RenderStepped:Connect(function(dt)
    dt = math.clamp(dt, 0, 0.067)
    Acc += dt
    if Acc >= UPDATE_INTERVAL then
        Acc = 0
        if not Settings.ESP then
            for _, v in pairs(ESP_List) do
                if v.NameTag then v.NameTag.Visible = false end
                if v.HealthTag then v.HealthTag.Visible = false end
                if v.Highlight then v.Highlight.Visible = false end
            end
            return
        end

        for Player, Data in pairs(ESP_List) do
            local Char = Player.Character
            local Hum = Char and Char:FindFirstChild("Humanoid")
            if not Char or not Hum or Hum.Health <= 0 then
                if Data.NameTag then Data.NameTag.Visible = false end
                if Data.HealthTag then Data.HealthTag.Visible = false end
                if Data.Highlight then Data.Highlight.Visible = false end
                if Target and Players:GetPlayerFromCharacter(Target) == Player then
                    RestoreCamera()
                end
                continue
            end

            Data.NameTag.Visible = true
            Data.HealthTag.Visible = true
            if Data.Highlight then Data.Highlight.Visible = true end

            local CurrentHealth = math.floor(Hum.Health + 0.5)
            local MaxHealth = math.floor(Hum.MaxHealth + 0.5)

            if CurrentHealth ~= Data.LastHealth or MaxHealth ~= (Data.LastMaxHealth or -1) then
                Data.LastHealth = CurrentHealth
                Data.LastMaxHealth = MaxHealth
                Data.HealthLabel.Text = "❤️ " .. CurrentHealth .. "/" .. MaxHealth

                local Ratio = Hum.Health / math.max(Hum.MaxHealth, 1)
                Data.HealthLabel.TextColor3 = Ratio > 0.4 and Color3.new(0, 1, 0.3)
                    or Ratio > 0.15 and Color3.new(1, 0.7, 0) or Color3.new(1, 0.1, 0.1)
            end
        end
    end
end)

-- === QUÉT NGƯỜI ĐÃ CÓ ===
for _, P in ipairs(Players:GetPlayers()) do task.spawn(AddESP, P) end
Players.PlayerAdded:Connect(AddESP)
Players.PlayerRemoving:Connect(RemoveESP)

-- === CHỌN MỤC TIÊU GẦN NHẤT ===
local function FindTarget()
    local Char = Me.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return nil end
    local MyPos = Char.HumanoidRootPart.Position
    local Best, MinDist = nil, math.huge
    for _, P in ipairs(Players:GetPlayers()) do
        if P == Me then continue end
        local PChar = P.Character
        if not PChar then continue end
        local PHum = PChar:FindFirstChild("Humanoid")
        local PHRP = PChar:FindFirstChild("HumanoidRootPart")
        if not PHum or not PHRP or PHum.Health <= 0 then continue end
        local D = (MyPos - PHRP.Position).Magnitude
        if D <= Settings.Range and D < MinDist then
            Best, MinDist = PChar, D
        end
    end
    return Best
end

-- === TẮT GIA TỐC RƠI ===
local function NoFall(Bool)
    local Char = Me.Character
    if not Char or not Char:FindFirstChild("Humanoid") then return end
    local H = Char.Humanoid
    if Bool then
        H.FallDamagePerFoot = 0
        NoFallDamage = H.HealthChanged:Connect(function() end)
    else
        if NoFallDamage then NoFallDamage:Disconnect() end
        H.FallDamagePerFoot = 0.25
    end
end

-- === XOAY QUANH MỤC TIÊU ===
RunService.RenderStepped:Connect(function(dt)
    dt = math.clamp(dt, 0, 0.033)
    local Char = Me.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then
        if CamLocked then RestoreCamera() end
        return
    end
    local MyPos = Char.HumanoidRootPart

    if not Settings.Spin or not Target then
        if CamLocked then RestoreCamera() end
        return
    end

    local THum = Target:FindFirstChild("Humanoid")
    local TRP = Target:FindFirstChild("HumanoidRootPart")
    if not THum or not TRP or THum.Health <= 0 then
        RestoreCamera()
        return
    end

    SaveCamera()
    pcall(function() Cam.CameraSubject = TRP; Cam.CameraType = Enum.CameraType.Follow end)

    local Step = Settings.Speed * dt
    Angle = (Angle + Step) % (math.pi * 2)
    local CosA, SinA = math.cos(Angle), math.sin(Angle)
    local Offset = Vector3.new(CosA * Settings.Radius, Settings.Height, SinA * Settings.Radius)
    MyPos.CFrame = CFrame.new(TRP.Position + Offset, TRP.Position)

    Char.Humanoid.GravityScale = 0
    Char.Humanoid.PlatformStand = true
end)

