-- Tìm mục tiêu khóa xoay
local function Lay()
    local M = Me.Character
    if not M or not M:FindFirstChild("HumanoidRootPart") then return nil end
    local MR = M.HumanoidRootPart
    local Best,D = nil,math.huge
    for _,P in next,Players:GetPlayers() do
        if P==Me then continue end
        local C_NhanVat = P.Character
        if not C_NhanVat then continue end
        local HM = C_NhanVat:FindFirstChild("Humanoid")
        local HR = C_NhanVat:FindFirstChild("HumanoidRootPart")
        if not HM or not HR or HM.Health<=0 then continue end
        local KhoangCach = (MR.Position - HR.Position).Magnitude
        if KhoangCach <= C.Vung and KhoangCach < D then Best,D = C_NhanVat,KhoangCach end
    end
    return Best
end

-- Chống sát thương
local function ChongSatThuong(Bat)
    local M = Me.Character
    if not M or not M:FindFirstChild("Humanoid") then return end
    local HM = M.Humanoid
    if Bat then
        HM.FallDamagePerFoot = 0
        HM.MaxHealth = math.huge
        HM.Health = math.huge
        KhongSatThuong = HM.HealthChanged:Connect(function() HM.Health = math.huge end)
    else
        if KhongSatThuong then KhongSatThuong:Disconnect() end
        HM.FallDamagePerFoot = 0.25
        HM.MaxHealth = 100
        HM.Health = 100
    end
end

-- Khôi phục camera
local function KhoiPhuc()
    if CamLuu then
        Cam.CameraSubject = CamLuu
        Cam.CameraType = CamTypeLuu
        CamLuu,CamTypeLuu = nil,nil
    end
    if Me.Character and Me.Character:FindFirstChild("Humanoid") then
        Me.Character.Humanoid.GravityScale = 1
        Me.Character.Humanoid.PlatformStand = false
    end
end

-- Chuyển tọa độ thế giới → màn hình
local function ToScreen(pos)
    local scr,ok = Cam:WorldToViewportPoint(pos)
    return ok and Vector2.new(scr.X,scr.Y) or nil, scr.Z
end

-- === TẠO ESP: HIGHLIGHT CẦU VỒNG + TÊN + THANH MÁU ===
local function TaoESP(Nguoi,NhanVat)
    if not Nguoi or not NhanVat or Nguoi == Me then return end
    -- Xóa cái cũ nếu còn sót
    if ESP_Container[Nguoi] then
        for _,v in pairs(ESP_Container[Nguoi]) do pcall(function() v:Destroy() end) end
        ESP_Container[Nguoi] = nil
    end
    local HM = NhanVat:WaitForChild("Humanoid",3)
    local HR = NhanVat:WaitForChild("HumanoidRootPart",3)
    if not HM or not HR then return end

    local ESP = {}
    -- Viền cầu vồng luôn hiện trên
    ESP.Highlight = Instance.new("Highlight")
    ESP.Highlight.FillTransparency = 1
    ESP.Highlight.OutlineTransparency = 0
    ESP.Highlight.OutlineColor = Color3.fromHSV(0,1,1)
    ESP.Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    ESP.Highlight.Adornee = NhanVat
    ESP.Highlight.Parent = NhanVat

    -- Tên trên đầu
    ESP.Ten = Instance.new("TextLabel")
    ESP.Ten.BackgroundTransparency = 1
    ESP.Ten.TextColor3 = Color3.new(1,1,1)
    ESP.Ten.Font = Enum.Font.GothamBold
    ESP.Ten.TextSize = 14
    ESP.Ten.TextStrokeTransparency = 0
    ESP.Ten.TextStrokeColor3 = Color3.new(0,0,0)
    ESP.Ten.Parent = Gui

    -- Thanh máu ngang trên đầu
    ESP.ThanhMau = Instance.new("Frame")
    ESP.ThanhMau.Size = UDim2.new(0,80,0,6)
    ESP.ThanhMau.BackgroundColor3 = Color3.new(0.2,0.2,0.2)
    ESP.ThanhMau.BorderSizePixel = 1
    ESP.ThanhMau.BorderColor3 = Color3.new(1,1,1)
    ESP.ThanhMau.Parent = Gui
    ESP.Mau = Instance.new("Frame")
    ESP.Mau.BackgroundColor3 = Color3.new(0,1,0)
    ESP.Mau.Size = UDim2.new(1,0,1,0)
    ESP.Mau.Parent = ESP.ThanhMau

    ESP_Container[Nguoi] = ESP
end

-- === TỰ ĐỘNG THÊM NGƯỜI MỚI / VỪA HỒI SINH ===
local function KhoiTaoNguoi(Nguoi)
    if Nguoi == Me then return end
    -- Khi nhân vật tái tạo
    Nguoi.CharacterAdded:Connect(function(NhanVat)
        task.wait(0.15)
        if Gui then TaoESP(Nguoi,NhanVat) end
    end)
    -- Nếu đã có nhân vật thì tạo luôn
    if Nguoi.Character then task.wait(0.15) TaoESP(Nguoi,Nguoi.Character) end
end

-- Khởi tạo tất cả người đang có mặt
for _,Nguoi in next,Players:GetPlayers() do KhoiTaoNguoi(Nguoi) end
-- Lắng nghe người mới vào server
Players.PlayerAdded:Connect(KhoiTaoNguoi)

-- === VÒNG LẶP CHÍNH ===
Run.RenderStepped:Connect(function(dt)
    -- Đổi màu cầu vồng mượt
    ThoiGian = (ThoiGian + dt*0.5) % 1
    local MauCauVong = Color3.fromHSV(ThoiGian,1,1)

    -- Cập nhật màu + vị trí + máu cho TẤT CẢ
    for Nguoi,ESP in pairs(ESP_Container) do
        if ESP.Highlight then ESP.Highlight.OutlineColor = MauCauVong end
        local NhanVat = Nguoi.Character
        local HM = NhanVat and NhanVat:FindFirstChild("Humanoid")
        local HR = NhanVat and NhanVat:FindFirstChild("HumanoidRootPart")
        if not HM or not HR or HM.Health<=0 or not NhanVat:IsDescendantOf(workspace) then
            for _,v in pairs(ESP) do pcall(function() v:Destroy() end) end
            ESP_Container[Nguoi] = nil
            continue
        end
        local VT,DoSau = ToScreen(HR.Position)
        if VT and DoSau>0 then
            local KichThuoc = math.clamp(2200/DoSau,40,180)
            local TiLeMau = HM.Health/HM.MaxHealth
            -- Cập nhật tên
            ESP.Ten.Position = UDim2.fromOffset(VT.X-40,VT.Y-KichThuoc*1.4)
            ESP.Ten.Text = Nguoi.Name
            -- Cập nhật thanh máu
            ESP.ThanhMau.Position = UDim2.fromOffset(VT.X-40,VT.Y-KichThuoc*1.2)
            ESP.Mau.Size = UDim2.new(TiLeMau,0,1,0)
            ESP.Mau.BackgroundColor3 = TiLeMau>0.3 and Color3.new(0,1,0) or Color3.new(1,0,0)
        end
    end

    -- === PHẦN XOAY + KHÓA MỤC TIÊU ===
    local M = Me.Character
    if not M or not M:FindFirstChild("HumanoidRootPart") then Tar=nil KhoiPhuc() return end
    if Tar then
        local HM = Tar:FindFirstChild("Humanoid")
        if not HM or HM.Health<=0 or not Tar:IsDescendantOf(workspace) then Tar=nil KhoiPhuc() return end
    end
    if not C.Xoay or not Tar then return end
    local HR = Tar:FindFirstChild("HumanoidRootPart")
    if not HR then Tar=nil KhoiPhuc() return end
    if not CamLuu then CamLuu,CamTypeLuu = Cam.CameraSubject,Cam.CameraType end
    Cam.CameraSubject = HR
    Cam.CameraType = Enum.CameraType.Follow
    local Buoc = C.TocDo * math.min(dt,0.03)
    Ang = (Ang + Buoc) % (math.pi*2)
    local Cos,Sin = math.cos(Ang),math.sin(Ang)
    local Off = Vector3.new(Cos*C.BanKinh,C.Cao,Sin*C.BanKinh)
    M.HumanoidRootPart.CFrame = CFrame.new(HR.Position+Off,HR.Position)
    M.Humanoid.GravityScale = 0
    M.Humanoid.PlatformStand = true
end)

