local Tar,Ang,Hien = nil,0,true
local CamLuu,CamTypeLuu = nil,nil
local C = {Xoay=false,Vung=20,BanKinh=9,TocDo=3.5,Cao=4}
local KhongSatThuong = nil
local ESP_Container = {}

-- Tìm mục tiêu khóa xoay
local function Lay()
    local M = Me.Character
    if not M or not M:FindFirstChild("HumanoidRootPart") then return nil end
    local MR = M.HumanoidRootPart
    local Best,D = nil,math.huge
    for _,P in next,Players:GetPlayers() do
        if P==Me then continue end
        local C_NhanVat = P.Character
        if not C_NhanVat then continue end
        local HM = C_NhanVat:FindFirstChild("Humanoid")
        local HR = C_NhanVat:FindFirstChild("HumanoidRootPart")
        if not HM or not HR or HM.Health<=0 then continue end
        local KhoangCach = (MR.Position - HR.Position).Magnitude
        if KhoangCach <= C.Vung and KhoangCach < D then Best,D = C_NhanVat,KhoangCach end
    end
    return Best
end

-- Chống sát thương
local function ChongSatThuong(Bat)
    local M = Me.Character
    if not M or not M:FindFirstChild("Humanoid") then return end
    local HM = M.Humanoid
    if Bat then
        HM.FallDamagePerFoot = 0
        HM.MaxHealth = math.huge
        HM.Health = math.huge
        KhongSatThuong = HM.HealthChanged:Connect(function() HM.Health = math.huge end)
    else
        if KhongSatThuong then KhongSatThuong:Disconnect() end
        HM.FallDamagePerFoot = 0.25
        HM.MaxHealth = 100
        HM.Health = 100
    end
end

-- Khôi phục camera
local function KhoiPhuc()
    if CamLuu then
        Cam.CameraSubject = CamLuu
        Cam.CameraType = CamTypeLuu
        CamLuu,CamTypeLuu = nil,nil
    end
    if Me.Character and Me.Character:FindFirstChild("Humanoid") then
        Me.Character.Humanoid.GravityScale = 1
        Me.Character.Humanoid.PlatformStand = false
    end
end

-- Chuyển tọa độ thế giới → màn hình
local function ToScreen(pos)
    local scr,ok = Cam:WorldToViewportPoint(pos)
    return ok and Vector2.new(scr.X,scr.Y) or nil, scr.Z
end

-- Tạo ESP cho 1 người (áp dụng cho tất cả)
local function TaoESP(Nguoi,NhanVat)
    if not NhanVat or ESP_Container[Nguoi] then return end
    local HM = NhanVat:WaitForChild("Humanoid",5)
    local HR = NhanVat:WaitForChild("HumanoidRootPart",5)
    if not HM or not HR then return end

    local ESP = {}
    -- Khung viền đỏ bao quanh
    ESP.Khung = Instance.new("Frame")
    ESP.Khung.BackgroundTransparency = 1
    ESP.Khung.BorderSizePixel = 2
    ESP.Khung.BorderColor3 = Color3.new(1,0,0)
    ESP.Khung.Parent = Gui

    -- Tên trên đầu
    ESP.Ten = Instance.new("TextLabel")
    ESP.Ten.BackgroundTransparency = 1
    ESP.Ten.TextColor3 = Color3.new(1,1,1)
    ESP.Ten.Font = Enum.Font.GothamBold
    ESP.Ten.TextSize = 14
    ESP.Ten.TextStrokeTransparency = 0
    ESP.Ten.TextStrokeColor3 = Color3.new(0,0,0)
    ESP.Ten.Parent = Gui

    -- Thanh máu ngang trên đầu
    ESP.ThanhMauTren = Instance.new("Frame")
    ESP.ThanhMauTren.Size = UDim2.new(0,80,0,6)
    ESP.ThanhMauTren.BackgroundColor3 = Color3.new(0.2,0.2,0.2)
    ESP.ThanhMauTren.BorderSizePixel = 1
    ESP.ThanhMauTren.BorderColor3 = Color3.new(1,1,1)
    ESP.ThanhMauTren.Parent = Gui
    ESP.MauTren = Instance.new("Frame")
    ESP.MauTren.BackgroundColor3 = Color3.new(0,1,0)
    ESP.MauTren.Size = UDim2.new(1,0,1,0)
    ESP.MauTren.Parent = ESP.ThanhMauTren

    -- Thanh máu dọc bên trái
    ESP.ThanhMauDoc = Instance.new("Frame")
    ESP.ThanhMauDoc.Size = UDim2.new(0,6,0,100)
    ESP.ThanhMauDoc.BackgroundColor3 = Color3.new(0.2,0.2,0.2)
    ESP.ThanhMauDoc.BorderSizePixel = 1
    ESP.ThanhMauDoc.BorderColor3 = Color3.new(1,1,1)
    ESP.ThanhMauDoc.Parent = Gui
    ESP.MauDoc = Instance.new("Frame")
    ESP.MauDoc.BackgroundColor3 = Color3.new(0,1,0)
    ESP.MauDoc.AnchorPoint = Vector2.new(0,1)
    ESP.MauDoc.Position = UDim2.new(0,0,1,0)
    ESP.MauDoc.Size = UDim2.new(1,0,1,0)
    ESP.MauDoc.Parent = ESP.ThanhMauDoc

    ESP_Container[Nguoi] = ESP
end

-- Cập nhật ESP cho TẤT CẢ
local function CapNhatTatCaESP()
    for Nguoi,ESP in pairs(ESP_Container) do
        local NhanVat = Nguoi.Character
        local HM = NhanVat and NhanVat:FindFirstChild("Humanoid")
        local HR = NhanVat and NhanVat:FindFirstChild("HumanoidRootPart")
        if not HM or not HR or HM.Health<=0 then
            for _,PhanTu in pairs(ESP) do PhanTu:Destroy() end
            ESP_Container[Nguoi] = nil
            continue
        end
        local VT,DoSau = ToScreen(HR.Position)
        if VT and DoSau>0 then
            local KichThuoc = math.clamp(2200/DoSau,40,180)
            local TiLeMau = HM.Health/HM.MaxHealth
            -- Vị trí & kích thước
            ESP.Khung.Position = UDim2.fromOffset(VT.X-KichThuoc/2,VT.Y-KichThuoc*1.1)
            ESP.Khung.Size = UDim2.fromOffset(KichThuoc,KichThuoc*2.2)
            -- Tên
            ESP.Ten.Position = UDim2.fromOffset(VT.X-40,VT.Y-KichThuoc*1.4)
            ESP.Ten.Text = Nguoi.Name
            -- Thanh máu ngang
            ESP.ThanhMauTren.Position = UDim2.fromOffset(VT.X-40,VT.Y-KichThuoc*1.2)
            ESP.MauTren.Size = UDim2.new(TiLeMau,0,1,0)
            ESP.MauTren.BackgroundColor3 = TiLeMau>0.3 and Color3.new(0,1,0) or Color3.new(1,0,0)
            -- Thanh máu dọc
            ESP.ThanhMauDoc.Position = UDim2.fromOffset(VT.X-KichThuoc/2-12,VT.Y-KichThuoc*0.1)
            ESP.MauDoc.Size = UDim2.new(1,0,TiLeMau,0)
            ESP.MauDoc.BackgroundColor3 = TiLeMau>0.3 and Color3.new(0,1,0) or Color3.new(1,0,0)
        end
    end
end

-- === TẠO ESP CHO TẤT CẢ NGƯỜI + TỰ ĐỘNG BẮT NGƯỜI MỚI ===
for _,Nguoi in next,Players:GetPlayers() do
    if Nguoi~=Me then
        if Nguoi.Character then TaoESP(Nguoi,Nguoi.Character) end
        Nguoi.CharacterAdded:Connect(function() task.wait(0.1) TaoESP(Nguoi,Nguoi.Character) end)
    end
end
Players.PlayerAdded:Connect(function(Nguoi)
    Nguoi.CharacterAdded:Connect(function() task.wait(0.1) TaoESP(Nguoi,Nguoi.Character) end)
    if Nguoi.Character then TaoESP(Nguoi,Nguoi.Character) end
end)

-- Vòng lặp chính xoay + camera
Run.RenderStepped:Connect(function(dt)
    local M = Me.Character
    if not M or not M:FindFirstChild("HumanoidRootPart") then Tar=nil KhoiPhuc() return end
    if Tar then
        local HM = Tar:FindFirstChild("Humanoid")
        if not HM or HM.Health<=0 or not Tar:IsDescendantOf(workspace) then Tar=nil KhoiPhuc() return end
    end
    if not C.Xoay or not Tar then KhoiPhuc() CapNhatTatCaESP() return end
    local HR = Tar:FindFirstChild("HumanoidRootPart")
    if not HR then Tar=nil KhoiPhuc() CapNhatTatCaESP() return end
    if not CamLuu then CamLuu,CamTypeLuu = Cam.CameraSubject,Cam.CameraType end
    Cam.CameraSubject = HR
    Cam.CameraType = Enum.CameraType.Follow
    local Buoc = C.TocDo * math.min(dt,0.03)
    Ang = (Ang + Buoc) % (math.pi*2)
    local Cos,Sin = math.cos(Ang),math.sin(Ang)
    local Off = Vector3.new(Cos*C.BanKinh,C.Cao,Sin*C.BanKinh)
    M.HumanoidRootPart.CFrame = CFrame.new(HR.Position+Off,HR.Position)
    M.Humanoid.GravityScale = 0
    M.Humanoid.PlatformStand = true
    CapNhatTatCaESP()
end)

