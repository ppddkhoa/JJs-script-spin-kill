local function CapNhatTocDo()
    local SoNhap = tonumber(NhanTocDo.Text)
    if SoNhap and SoNhap >= 0.5 and SoNhap <= 2000000 then
        C.TocDo = SoNhap
        NhanTocDo.Text = "⚡ Tốc độ: "..SoNhap
    else
        NhanTocDo.Text = "⚡ Tốc độ: "..C.TocDo
    end
end
