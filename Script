local KhongSatThuong = nil

-- Tìm mục tiêu
local function Lay()
    local M = Me.Character
    if not M or not M:FindFirstChild("HumanoidRootPart") then return nil end
    local MR = M.HumanoidRootPart
    local Best,D = nil,math.huge
    for _,P in next,Players:GetPlayers() do
        if P==Me then continue end
        local C_NhanVat = P.Character
        if not C_NhanVat then continue end
        local HM = C_NhanVat:FindFirstChild("Humanoid")
        local HR = C_NhanVat:FindFirstChild("HumanoidRootPart")
        if not HM or not HR or HM.Health<=0 then continue end
        local KhoangCach = (MR.Position - HR.Position).Magnitude
        if KhoangCach <= C.Vung and KhoangCach < D then Best,D = C_NhanVat,KhoangCach end
    end
    return Best
end

-- Bật/Tắt chống sát thương
local function ChongSatThuong(Bat)
    local M = Me.Character
    if not M or not M:FindFirstChild("Humanoid") then return end
    local HM = M.Humanoid
    if Bat then
        -- Khóa máu tối đa, bỏ qua mọi sát thương
        HM.FallDamagePerFoot = 0
        HM.MaxHealth = math.huge
        HM.Health = math.huge
        KhongSatThuong = HM.HealthChanged:Connect(function() HM.Health = math.huge end)
    else
        -- Khôi phục bình thường
        if KhongSatThuong then KhongSatThuong:Disconnect() end
        HM.FallDamagePerFoot = 0.25
        HM.MaxHealth = 100
        HM.Health = 100
    end
end

-- Vòng lặp chính
Run.RenderStepped:Connect(function(dt)
    local M = Me.Character
    if not M or not M:FindFirstChild("HumanoidRootPart") then return end
    local MR = M.HumanoidRootPart

    if not C.Xoay or not Tar then
        M.Humanoid.GravityScale = 1
        M.Humanoid.PlatformStand = false
        return
    end

    local HM = Tar:FindFirstChild("Humanoid")
    local HR = Tar:FindFirstChild("HumanoidRootPart")
    if not HM or not HR or HM.Health<=0 then
        Tar = nil
        M.Humanoid.GravityScale = 1
        M.Humanoid.PlatformStand = false
        return
    end

    Ang += C.TocDo * dt
    MR.CFrame = CFrame.new(HR.Position + Vector3.new(math.cos(Ang)*C.BanKinh,C.Cao,math.sin(Ang)*C.BanKinh), HR.Position)
    M.Humanoid.GravityScale = 0
    M.Humanoid.PlatformStand = true
end)

