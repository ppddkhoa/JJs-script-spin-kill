local function Keo(Obj)
    local DangKeo, LechX, LechY = false, 0, 0
    Obj.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            DangKeo = true
            LechX = i.Position.X - Obj.AbsolutePosition.X
            LechY = i.Position.Y - Obj.AbsolutePosition.Y
        end
    end)
    Obj.InputChanged:Connect(function(i)
        if DangKeo and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            Obj.Position = UDim2.new(0, i.Position.X - LechX, 0, i.Position.Y - LechY)
        end
    end)
    Obj.InputEnded:Connect(function() DangKeo = false end)
end
