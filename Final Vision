local function Thanh(Ten,Min,Max,MacDinh,Khoa,ViTri)
    local Lb=Instance.new("TextLabel") Lb.Size=UDim2.new(1,0,0,20) Lb.Position=UDim2.new(0,0,0,ViTri) Lb.BackgroundTransparency=1
    Lb.Text=Ten..": "..MacDinh Lb.TextColor3=Color3.new(0.9,0.9,0.9) Lb.Font=Enum.Font.Gotham Lb.TextSize=13 Lb.Parent=Khung
    local Bar=Instance.new("TextButton") Bar.Size=UDim2.new(1,0,0,18) Bar.Position=UDim2.new(0,0,0,ViTri+20) Bar.BackgroundColor3=Color3.new(0.2,0.2,0.4) Bar.Text="" Bar.Parent=Khung
    local Nut=Instance.new("Frame") Nut.Size=UDim2.new(0,15,1,0) Nut.BackgroundColor3=Color3.new(0,1,1)
    Nut.Position=UDim2.new((MacDinh-Min)/(Max-Min),-7,0,0) Nut.Parent=Bar
    local K=false
    Bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then K=true end end)
    Bar.InputChanged:Connect(function(i)
        if K and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            local TyLe=math.clamp((i.Position.X-Bar.AbsolutePosition.X)/Bar.AbsoluteSize.X,0,1)
            local GiaTri=Min+(Max-Min)*TyLe
            GiaTri=math.floor(GiaTri*10)/10
            C[Khoa]=GiaTri
            Nut.Position=UDim2.new(TyLe,-7,0,0)
            Lb.Text=Ten..": "..GiaTri
        end
    end)
    Bar.InputEnded:Connect(function() K=false end)
end

