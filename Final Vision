local function Lay()
    if not Me.Character or not Me.Character:FindFirstChild("HumanoidRootPart") then return end
    local ViTriToi = Me.Character.HumanoidRootPart.Position
    local GanNhat, KC_Nho = nil, math.huge
    for _, Nguoi in next, Players:GetPlayers() do
        if Nguoi == Me or not Nguoi.Character then continue end
        local HM = Nguoi.Character:FindFirstChild("Humanoid")
        local HR = Nguoi.Character:FindFirstChild("HumanoidRootPart")
        if HM and HR and HM.Health > 0 then
            local KC = (ViTriToi - HR.Position).Magnitude
            if KC <= C.Vung and KC < KC_Nho then
                GanNhat, KC_Nho = Nguoi.Character, KC
            end
        end
    end
    -- ✅ CẬP NHẬT NGAY KHI CHỌN GẦN NHẤT
    if GanNhat then
        Tar = GanNhat
        local NguoiChon = Players:GetPlayerFromCharacter(Tar)
        if NguoiChon and TrangThai then
            TrangThai.Text = "🎯 Khóa: "..string.upper(NguoiChon.DisplayName or NguoiChon.Name)
        end
    end
    return GanNhat
end

local function LayTheoTen(Ten)
    if not Ten or Ten == "" then return end
    local T = string.lower(Ten)
    for _, N in next, Players:GetPlayers() do
        if N ~= Me and N.Character and N.Character:FindFirstChild("Humanoid") and N.Character.Humanoid.Health > 0 then
            local TenThat = string.lower(N.Name)
            local BietDanh = string.lower(N.DisplayName or "")
            if TenThat == T or string.find(BietDanh, T, 1, true) or string.find(TenThat, T, 1, true) then
                -- ✅ CẬP NHẬT NGAY KHI TÌM ĐƯỢC
                Tar = N.Character
                if TrangThai then
                    TrangThai.Text = "🎯 Khóa: "..string.upper(N.DisplayName or N.Name)
                end
                return N.Character
            end
        end
    end
    return nil
end

local function ChongBat(Bat)
    if not Me.Character or not Me.Character:FindFirstChild("Humanoid") then return end
    local N = Me.Character.Humanoid
    if Bat then
        KhongSatThuong = N.HealthChanged:Connect(function()
            if N.Health < N.MaxHealth then N.Health = N.MaxHealth end
        end)
    else
        if KhongSatThuong then KhongSatThuong:Disconnect() end
    end
end

local function KhoiPhuc()
    if Me.Character and Me.Character:FindFirstChild("Humanoid") then
        local H = Me.Character.Humanoid
        H.GravityScale = 1
        H.PlatformStand = false
        H:ChangeState(Enum.HumanoidStateType.Running)
    end
    if CamLuu then Cam.CameraSubject = CamLuu Cam.CameraType = CamTypeLuu end
    CamLuu, CamTypeLuu = nil, nil
end

local function TaoESP(Nguoi, NhanVat)
    if not Nguoi or Nguoi == Me or not NhanVat then return end
    if ESP_Container[Nguoi] then for _,v in pairs(ESP_Container[Nguoi]) do pcall(function() v:Destroy() end) end end
    local H = NhanVat:FindFirstChild("Humanoid") local R = NhanVat:FindFirstChild("HumanoidRootPart")
    if not H or not R then return end
    local E = {}
    E.HL = Instance.new("Highlight")
    E.HL.FillTransparency = 1 E.HL.OutlineTransparency = 0
    E.HL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    E.HL.Adornee = NhanVat E.HL.Parent = Gui
    E.Ten = Instance.new("TextLabel")
    E.Ten.BackgroundTransparency = 1 E.Ten.TextColor3 = Color3.new(1,1,1)
    E.Ten.Font = Enum.Font.GothamBold E.Ten.TextSize = 14
    E.Ten.TextStrokeTransparency = 0 E.Ten.TextStrokeColor3 = Color3.new(0,0,0) E.Ten.Parent = Gui
    E.Thanh = Instance.new("Frame")
    E.Thanh.Size = UDim2.new(0,80,0,6) E.Thanh.BackgroundColor3 = Color3.new(0.2,0.2,0.2)
    E.Thanh.BorderSizePixel = 1 E.Thanh.BorderColor3 = Color3.new(1,1,1) E.Thanh.Parent = Gui
    E.Mau = Instance.new("Frame")
    E.Mau.BackgroundColor3 = Color3.new(0,1,0) E.Mau.Size = UDim2.new(1,0,1,0) E.Mau.Parent = E.Thanh
    E.So = Instance.new("TextLabel")
    E.So.BackgroundTransparency = 1 E.So.TextColor3 = Color3.new(1,1,0)
    E.So.Font = Enum.Font.GothamBold E.So.TextSize = 12 E.So.TextStrokeTransparency = 0 E.So.Parent = Gui
    ESP_Container[Nguoi] = E
end

for _, N in next, Players:GetPlayers() do if N ~= Me and N.Character then task.spawn(TaoESP,N,N.Character) end end
Players.PlayerAdded:Connect(function(N) N.CharacterAdded:Connect(function(C) task.wait(0.05) TaoESP(N,C) end) end)

RunService.RenderStepped:Connect(function(dt)
    local M = os.clock()%1
    local R,G,B = math.sin(M*6.28)*0.5+0.5, math.sin(M*6.28+2.09)*0.5+0.5, math.sin(M*6.28+4.18)*0.5+0.5
    for _,E in pairs(ESP_Container) do if E and E.HL then E.HL.OutlineColor=Color3.new(R,G,B) end end

    if not Me.Character or not C.Xoay or not Tar then return end
    local D = Tar:FindFirstChild("Humanoid") local P = Tar:FindFirstChild("HumanoidRootPart")
    if not D or not P or D.Health<=0 or not Tar:IsDescendantOf(workspace) then
        C.Xoay = false
        NutXoay.BackgroundColor3 = Color3.new(0.3,0.3,0.3)
        NutXoay.Text = "🌀 Bật xoay"
        ChongBat(false)
        KhoiPhuc()
        Tar = nil
        if TrangThai then TrangThai.Text = "🎯 Chưa chọn" end
        return
    end
    if not CamLuu then CamLuu,CamTypeLuu=Cam.CameraSubject,Cam.CameraType end
    Cam.CameraSubject=P Cam.CameraType=Enum.CameraType.Follow
    Ang=(Ang+C.TocDo*math.min(dt,0.03))%(math.pi*2)
    local Cx,Sy=math.cos(Ang),math.sin(Ang)
    Me.Character.HumanoidRootPart.CFrame=CFrame.new(P.Position+Vector3.new(Cx*C.BanKinh,C.Cao,Sy*C.BanKinh),P.Position)
    Me.Character.Humanoid.GravityScale=0 Me.Character.Humanoid.PlatformStand=true

    for Nguoi,E in pairs(ESP_Container) do
        if not Nguoi or not Nguoi.Character or not E then continue end
        local H=Nguoi.Character:FindFirstChild("Humanoid") local R=Nguoi.Character:FindFirstChild("HumanoidRootPart")
        if not H or not R then continue end
        local Pos,Vis=Cam:WorldToViewportPoint(R.Position+Vector3.new(0,2.5,0))
        if Vis then
            E.Ten.Position=UDim2.new(0,Pos.X-40,0,Pos.Y-70)
            E.Ten.Text=Nguoi.DisplayName~=Nguoi.Name and Nguoi.DisplayName.." ("..Nguoi.Name..")" or Nguoi.Name
            E.Thanh.Position=UDim2.new(0,Pos.X-40,0,Pos.Y-50)
            E.Mau.Size=UDim2.new(H.Health/H.MaxHealth,0,1,0)
            E.Mau.BackgroundColor3=H.Health/H.MaxHealth>0.3 and Color3.new(0,1,0) or Color3.new(1,0,0)
            E.So.Position=UDim2.new(0,Pos.X-30,0,Pos.Y-35)
            E.So.Text=math.floor(H.Health).." / "..math.floor(H.MaxHealth)
        end
    end
end)

